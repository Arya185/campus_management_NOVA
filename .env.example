# ─────────────────────────────────────────────────────────
# NOVA Campus — Root Environment Variables Example
# Copy this file to apps/web/.env.local and fill in values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB_NAME=nova

# ── NextAuth ─────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── App URL ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI / OpenRouter ──────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Razorpay (Payments) ───────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Vapi AI (Voice Assistant) ─────────────────────────────
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_WEB_TOKEN=
NEXT_PUBLIC_VAPI_API_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_PRIVATE_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# ── Admin Seeder (used by: npm run seed:admin) ────────────
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── ML API ───────────────────────────────────────────────
PERFORMANCE_PREDICTOR_API_URL=http://localhost:5001
